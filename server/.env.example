# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<db_username>:<db_password>@h2rsports.7bmidoo.mongodb.net/h2r-sports?retryWrites=true&w=majority&appName=H2RSPORTS

# Local MongoDB (optional)
# MONGO_URI=mongodb://localhost:27017/h2r-sports

PORT=5000
JWT_SECRET=change_this_to_a_long_random_string

# Public API origin (Render) — used in media / upload absolute URLs
PUBLIC_API_URL=https://h2r-sports.onrender.com

# Public client origin(s) — used to (1) build password-reset / verify-email links and
# (2) restrict CORS so only your own frontend can call this API. Comma-separate multiple
# domains (e.g. custom domain + Netlify subdomain + www). Optional locally (falls back to
# the request Origin header for email links, and to wide-open CORS if left unset).
# IMPORTANT: set this on Render before go-live — until it's set, CORS stays open to all
# origins, same as before this was added, so nothing breaks while you haven't configured it.
CLIENT_URL=https://h2rsports.in,https://www.h2rsports.in,https://h2r-sports.netlify.app

# Razorpay — set BOTH pairs so the admin can flip Test ⇄ Live from Admin → Integrations
# without ever touching env vars again. Which one is actually used is controlled by the
# "paymentMode" toggle (stored in MongoDB), not by which vars happen to be set.
#   Test keys:  Razorpay Dashboard → Test Mode → Settings → API Keys
#   Live keys:  Razorpay Dashboard → Live Mode → Settings → API Keys (needs KYC approval)
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_TEST_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=xxxxxxxxxxxxxxxx

# Webhooks (Razorpay Dashboard → Webhooks → payment.captured). Test Mode and Live Mode each
# have their own separate webhook config, but can both point at the SAME URL below — the
# server tries both secrets and figures out which mode fired.
# URL: https://h2r-sports.onrender.com/api/payments/razorpay/webhook
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# Legacy single-pair fallback (kept for backward compatibility with older deployments).
# Only used for whichever mode its rzp_test_/rzp_live_ prefix matches, and only if the
# mode-specific vars above aren't set. New setups should use the TEST_/LIVE_ vars instead.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=

# Order mail — send from YOUR mailbox; client Gmail only receives copies
# SMTP_USER / SMTP_PASS = freelancer Gmail App Password, Hostinger mailbox, or Brevo SMTP
# STORE_EMAIL = client inbox (BCC + Reply-To). Do not ask the client for Gmail 2FA.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
STORE_EMAIL=h2rsports7@gmail.com
STORE_PHONE=+91 99949 78963

# Product images & marketing videos are stored in MongoDB (survive Render restarts).
