# Local development (vite dev against local API)
# VITE_API_URL=http://localhost:5000/api

# Point Vite at the live Render API (useful before deploy / push)
VITE_API_URL=https://h2r-sports.onrender.com/api

# Production is also set in:
# - client/.env.production
# - netlify.toml → VITE_API_URL=https://h2r-sports.onrender.com/api
